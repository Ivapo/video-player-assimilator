{
  "name": "video-player-assimilator",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tsc --noEmit && vite build --mode desktop --base=./ --outDir dist-desktop",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:chrome": "playwright test",
    "test:safari": "vitest run --config vitest.safari.config.ts",
    "test:desktop": "tsx test/desktop/run.ts",
    "fixtures": "bash scripts/make-fixture.sh",
    "tauri": "tauri",
    "tauri:gate": "CARGO_TARGET_DIR=src-tauri/target-gate tauri build --bundles app --features gate"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "~2.12.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "webdriverio": "^9.32.0"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.0"
  }
}
